{
	"name": "nina-cli",
	"module": "index.ts",
	"type": "module",
	"scripts": {
		"dev": "bun run index.ts --help",
		"commit": "bun run index.ts commit",
		"kill": "bun run index.ts kill",
		"list": "bun run index.ts list",
		"repo-structure": "bun run index.ts repo-structure",
		"lint": "bunx biome check --write",
		"check": "bun x tsc --noEmit && bun x @biomejs/biome check . --diagnostic-level=info",
		"compile": "bun build --compile --minify --sourcemap ./index.ts --outfile nina",
		"move": "sudo mv nina /usr/local/bin/",
		"e2e": "bun x tsc --noEmit",
		"deploy": "bun run index.ts deploy",
		"build": "bun run index.ts build",
		"release": "bun run index.ts release",
		"start": "bun run index.ts start",
		"documentation": "bun run index.ts documentation"
	},
	"private": true,
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"@types/bun": "latest"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"@azure/data-tables": "^13.3.2",
		"@azure/identity": "^4.13.0",
		"@google/generative-ai": "^0.24.1",
		"@types/node": "^25.0.3",
		"chalk": "^5.6.2",
		"cli-table3": "^0.6.5",
		"commander": "^14.0.2",
		"dotenv": "^17.2.3",
		"simple-git": "^3.30.0"
	}
}
