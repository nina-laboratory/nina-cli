{
	"name": "nina-cli",
	"module": "index.ts",
	"type": "module",
	"scripts": {
		"lint": "bunx biome check --write",
		"check": "bun x tsc --noEmit && bun x @biomejs/biome check . --diagnostic-level=info",
		"build": "bun build --compile --minify --sourcemap ./index.ts --outfile nina",
		"e2e": "bun x tsc --noEmit"
	},
	"private": true,
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"@types/bun": "latest"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"@google/generative-ai": "^0.24.1",
		"@types/node": "^25.0.3",
		"chalk": "^5.6.2",
		"cli-table3": "^0.6.5",
		"commander": "^14.0.2",
		"dotenv": "^17.2.3",
		"simple-git": "^3.30.0"
	}
}
